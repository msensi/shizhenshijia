# ===== 是真是假 后端配置模板（Spec 第 8 节全量） =====
# 用法：cp .env.example .env 后填入真实值。密钥严禁提交 Git / 写入日志 / 出现在响应中

# --- 模型服务（阿里千问，key 由用户提供） ---
LLM_PROVIDER=dashscope
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 锁快照版本号，禁止 -latest（ADR-001）
VISION_MODEL=qwen3-vl-flash-2026-01-22
TEXT_MODEL=qwen-plus
SEARCH_MODEL=
LLM_TEMPERATURE=0
# 视觉模型不可用时的备用快照（CircuitBreaker 降级用）
VISION_MODEL_FALLBACK=qwen3-vl-plus-2025-12-19
TEXT_MODEL_FALLBACK=qwen-flash

# --- 统一知识库（阿里百炼 RAG 知识检索；key 复用 LLM_API_KEY） ---
KNOWLEDGE_BASE_PROVIDER=bailian
KNOWLEDGE_BASE_URL=https://ws-gaemrqt57ahk92ih.cn-beijing.maas.aliyuncs.com/api/v1/indices/knowledge/search
KNOWLEDGE_BASE_API_KEY=
KNOWLEDGE_BASE_AGENT_ID=
KNOWLEDGE_BASE_COLLECTION=szsj_authority_evidence
KNOWLEDGE_BASE_TOP_K=5
KNOWLEDGE_BASE_DOCUMENT_REGISTRY_PATH=config/kb_document_registry.json
EMBEDDING_MODEL=text-embedding-v4

# --- 联网搜索（阿里百炼 WebSearch MCP；key 复用 LLM_API_KEY，博查已废弃） ---
SEARCH_PROVIDER=qwen
SEARCH_API_KEY=
SEARCH_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
SEARCH_MAX_CALLS_PER_ANALYSIS=3
SEARCH_DAILY_QUOTA=600
# 日成本红线（分）：25 元 = 2500 分
SEARCH_DAILY_COST_LIMIT_FEN=2500
SOURCE_REGISTRY_PATH=config/source_registry.yaml

# --- 快速核验（明确场景直判 + 三层证据并行） ---
FAST_SCOPE_ENABLED=true
PARALLEL_EVIDENCE_ENABLED=true
FAST_EVIDENCE_JUDGE_LIMIT=2

# --- 主核验对象排序规则 ---
VISUAL_DEMOTION_SCORE=18

# --- MCP（可选能力，通过适配层接入；MVP 默认关闭） ---
MCP_ENABLED=false
MCP_SEARCH_SERVER_URL=
MCP_SEARCH_AUTH_TOKEN=
MCP_KNOWLEDGE_SERVER_URL=
MCP_KNOWLEDGE_AUTH_TOKEN=

# --- 图片与数据保存（隐私最小化：默认只存哈希） ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=var/images
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
IMAGE_RETENTION_DAYS=0
# 兼容旧部署；当前版本无论此值为何都不会保存原图
KEEP_ORIGINAL_IMAGE=false
ADMIN_ACCESS_TOKEN=

# --- 图片格式与转换（HEIF/HEIC 支持） ---
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,heif,heic
HEIF_CONVERT_TO=jpeg
IMAGE_MAX_SIZE_MB=10
ANALYSIS_TIMEOUT_SECONDS=60

# --- 服务运行 ---
APP_ENV=development
DATABASE_URL=sqlite:///var/szsj.db
LOG_LEVEL=INFO
